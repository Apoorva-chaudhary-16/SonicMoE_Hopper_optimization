import math
from typing import Type
import cuda.bindings.driver as cuda
import cutlass
import cutlass.cute as cute
import torch
from cutlass.cute.runtime import from_dlpack
from quack.cute_dsl_utils import torch2cute_dtype_map

LOG2E = 1.4426950408889634

def topk_softmax_triton(x, k, values, indices, require_softmax_fusion=True):
    logits_f32 = x.float()
    topk_vals, topk_idx = torch.topk(logits_f32, k, dim=-1)
    shifted = topk_vals - topk_vals.max(dim=-1, keepdim=True).values
    exp_vals = torch.exp2(shifted * LOG2E)
    softmax_vals = exp_vals / exp_vals.sum(dim=-1, keepdim=True)
    values.copy_(softmax_vals.to(values.dtype))
    indices.copy_(topk_idx.to(indices.dtype))

class FusedRouterTopKSoftmax_SM90:
    def __init__(self, input_dtype, output_dtype, E, k, require_softmax_fusion=True, T_tile=32):
        self.input_dtype = input_dtype
        self.output_dtype = output_dtype
        self.E = E
        self.k = k
    @cute.jit
    def __call__(self, mLogits, mValues, mIndices, stream):
        pass

def test_fused_vs_separate(T=1024, E=128, k=8, dtype=torch.bfloat16):
    logits = torch.randn(T, E, device="cuda", dtype=dtype)
    logits_f32 = logits.float()
    ref_topk_vals, ref_idx = torch.topk(logits_f32, k, dim=-1)
    ref_sm = torch.softmax(ref_topk_vals, dim=-1)
    fused_vals = torch.zeros(T, k, device="cuda", dtype=torch.float32)
    fused_idx = torch.zeros(T, k, device="cuda", dtype=torch.int32)
    topk_softmax_triton(logits, k, fused_vals, fused_idx)
    torch.cuda.synchronize()
    ref_idx_sorted, _ = ref_idx.sort(dim=-1)
    fused_idx_sorted, _ = fused_idx.sort(dim=-1)
    assert torch.all(ref_idx_sorted == fused_idx_sorted), "TopK index mismatch"
    max_err = (ref_sm.gather(1, ref_idx.argsort(dim=-1)) - fused_vals.gather(1, fused_idx.long().argsort(dim=-1))).abs().max().item()
    assert max_err < 2e-3, f"Softmax error: {max_err}"
    print(f"[PASS] T={T}, E={E}, k={k} (max_err={max_err:.2e})")

if __name__ == "__main__":
    test_fused_vs_separate(T=1024, E=128, k=8)
    test_fused_vs_separate(T=4096, E=64, k=4)
    print("All tests passed.")

TopK_Softmax_Hopper = FusedRouterTopKSoftmax_SM90
TopK_Softmax = FusedRouterTopKSoftmax_SM90

def fast_exp(x):
    return math.exp(x)

def online_softmax_update(new_val, running_max, running_sum):
    new_max = max(running_max, new_val)
    scale = math.exp2((running_max - new_max) * LOG2E)
    new_sum = running_sum * scale + math.exp2((new_val - new_max) * LOG2E)
    return new_max, new_sum
